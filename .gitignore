# ============================================================
# Miru Assistant monorepo
# ============================================================

# Product-local secrets and private configuration
.secrets/
products/daily-report/config/settings.yaml
products/daily-report/config/contacts.yaml
products/daily-report/config/database_keys.yaml
products/mobile-assistant/server/.env
products/mobile-assistant/server/config/settings.yaml
products/mobile-assistant/server/config/persona/*.yaml
!products/mobile-assistant/server/config/persona/*.example.yaml

# Private reports and runtime data
products/daily-report/data/
products/daily-report/output/
products/daily-report/backup/
products/daily-report/chatlog/
products/daily-report/tools/
products/daily-report/docs/reports/
products/mobile-assistant/server/data/

# Python environments and generated artifacts
venv/
**/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.test-tmp/
build/
dist/

# Flutter / Dart generated artifacts
.dart_tool/
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
*.iml

# System and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
