# 复制为 .env（gitignore 已忽略），或在系统环境变量中设置。
# 后端通过 ${VAR} 语法在 settings.yaml 中引用这些变量。

# DeepSeek（必填，聊天功能）
MIRU_DEEPSEEK_API_KEY=

# MiniMax TTS（可选；不配则语音回答降级为 edge-tts，再降级为纯文字）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Cloud STT（推荐：腾讯云一句话识别；确认控制台关闭后付费后才设置安全门）
MIRU_TENCENT_ASR_SECRET_ID=
MIRU_TENCENT_ASR_SECRET_KEY=
MIRU_TENCENT_ASR_BILLING_GUARD=  # 确认关闭后付费后填写 postpay-disabled

# 可选备用：阿里云百炼 Qwen ASR（当前不作为生产默认值）
MIRU_STT_BASE_URL=
MIRU_STT_API_KEY=

# 服务端访问令牌（手机端 hello/Authorization 用同一值）
# 不设置则每次启动随机生成并打印到日志——正式使用务必固定下来
MIRU_SERVER_TOKEN=

# 未来 VLM（图片理解，MVP6）
DASHSCOPE_API_KEY=
